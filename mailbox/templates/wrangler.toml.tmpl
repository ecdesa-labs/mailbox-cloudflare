name = "$worker"
main = "worker/build/worker/shim.mjs"
compatibility_date = "2026-10-01"

[build]
command = "cd worker && worker-build --release"
watch_dir = ["worker/src", "crates"]

# Front estático. /api/* sempre passa pelo Worker; o resto cai no SPA.
[assets]
directory = "web/out"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = ["/api/*"]

[[r2_buckets]]
binding = "MAIL"
bucket_name = "$bucket"

[[d1_databases]]
binding = "DB"
database_name = "$database"
# Local aceita um placeholder. Para deploy: `just remote-bootstrap` e depois
# `python3 scripts/setup_instance.py --database-id <id que o wrangler imprimiu>` (na raiz).
database_id = "$database_id"
migrations_dir = "migrations"

[[queues.producers]]
queue = "$queue"
binding = "INGEST"

# Plano Free: 10 ms de CPU e 50 sub-requisições por invocação. Um email por
# invocação, para cada um ter o orçamento inteiro.
[[queues.consumers]]
queue = "$queue"
max_batch_size = 1
max_retries = 3
dead_letter_queue = "$dlq"

# DLQ: só registra a desistência em ingest_failures (docs seção 6.6).
[[queues.consumers]]
queue = "$dlq"
max_batch_size = 10
max_retries = 3

# Reconciliação R2 x D1 e pedidos de `just reprocess`.
[triggers]
crons = ["*/10 * * * *"]

# Domínios atendidos pelo handler de email (o resto é rejeitado).
[vars]
MAILBOX_DOMAINS = "$domains"
MAILBOX_DLQ = "$dlq"
# Acima disso, modo leve (só headers). Calibrar pelo CPU real (observability).
MAILBOX_FULL_MAX_BYTES = "524288"
MAILBOX_MAX_ATTACHMENTS = "30"
MAILBOX_RECONCILE_BUDGET = "50"

[observability]
enabled = true
