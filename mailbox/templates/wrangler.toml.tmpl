name = "$worker"
main = "worker/build/worker/shim.mjs"
compatibility_date = "2026-10-01"

[build]
command = "cd worker && worker-build --release"
watch_dir = ["worker/src", "crates"]

# Front estático. /api/* sempre passa pelo Worker; o resto cai no SPA.
[assets]
directory = "web/out"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = ["/api/*"]

[[r2_buckets]]
binding = "MAIL"
bucket_name = "$bucket"

[[d1_databases]]
binding = "DB"
database_name = "$database"
# Local aceita um placeholder. Para deploy: `just remote-bootstrap` e depois
# `python3 scripts/setup_instance.py --database-id <id que o wrangler imprimiu>` (na raiz).
database_id = "$database_id"
migrations_dir = "migrations"

[[queues.producers]]
queue = "$queue"
binding = "INGEST"

# Um email por invocação: cada um tem o orçamento inteiro (CPU no Free,
# memória no Paid) e uma falha não atrasa os outros.
[[queues.consumers]]
queue = "$queue"
max_batch_size = 1
max_retries = 3
dead_letter_queue = "$dlq"

# DLQ: só registra a desistência em ingest_failures (docs seção 6.6).
[[queues.consumers]]
queue = "$dlq"
max_batch_size = 10
max_retries = 3

# Envio e resposta (docs seção 6.4): Cloudflare Email Sending, plano
# Workers Paid. Só sai de domínio verificado no Email Sending; a API só
# aceita como remetente uma identidade cadastrada.
[[send_email]]
name = "MAILER"

# Reconciliação R2 x D1 e pedidos de `just reprocess`.
[triggers]
crons = ["*/10 * * * *"]

# Domínios atendidos pelo handler de email (o resto é rejeitado).
[vars]
MAILBOX_DOMAINS = "$domains"
MAILBOX_DLQ = "$dlq"
# Limiares do plano $plan (PLAN_LIMITS em scripts/setup_instance.py). Acima de
# FULL_MAX_BYTES, modo leve (só headers); o evento `process` traz `wasm_mib`
# para calibrar contra os 128 MB do isolate.
MAILBOX_FULL_MAX_BYTES = "$full_max_bytes"
MAILBOX_MAX_ATTACHMENTS = "$max_attachments"
MAILBOX_RECONCILE_BUDGET = "$reconcile_budget"
# Retenção (dias; 0 = nunca): lixeira e spam contam de quando a mensagem foi
# para lá; ocultas por regra `reject`, de quando foram ocultadas.
MAILBOX_RETENTION_TRASH_DAYS = "30"
MAILBOX_RETENTION_SPAM_DAYS = "30"
MAILBOX_RETENTION_HIDDEN_DAYS = "30"
MAILBOX_RETENTION_BATCH = "$retention_batch"
# Cloudflare Access (docs seção 6.5). Vazios = API negada (falha fechada).
MAILBOX_ACCESS_TEAM = "$access_team"
MAILBOX_ACCESS_AUD = "$access_aud"
MAILBOX_ALLOWED_EMAILS = "$allowed_emails"

$metrics_block[observability]
enabled = true
