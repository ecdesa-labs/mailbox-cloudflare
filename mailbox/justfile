set shell := ["bash", "-euo", "pipefail", "-c"]
# Nomes dos recursos da instância. Gerado por scripts/setup_instance.py.
set dotenv-filename := "instance.env"
set dotenv-required

default:
    @just --list

# Pré-requisitos do sistema (Debian/Kali): sudo apt install -y pkg-config libssl-dev
setup:
    rustup target add wasm32-unknown-unknown
    cargo install worker-build --locked

fmt:
    cargo fmt --all

lint:
    cargo fmt --all -- --check
    cargo clippy -p mailbox-domain -p mailbox-application -p mailbox-mime --all-targets -- -D warnings
    cargo clippy --target wasm32-unknown-unknown -p mailbox-adapters-cf -p mailbox-worker -- -D warnings

# Testes nativos: só os crates puros (docs seção 11)
test:
    cargo test -p mailbox-domain -p mailbox-application -p mailbox-mime

check-wasm:
    cargo check --target wasm32-unknown-unknown -p mailbox-adapters-cf -p mailbox-worker

# Regra de dependência (seção 4.1): domain/application/mime não podem puxar `worker`.
check-deps:
    ! cargo tree -p mailbox-domain -p mailbox-application -p mailbox-mime -e normal --prefix none | grep -E '^(worker|worker-sys|wasm-bindgen|js-sys|web-sys) '

# Build completo do Worker (pega o tipo de falha do wasm-bindgen que `check` sozinho não pega)
build:
    cd worker && worker-build --release

# Arquivos gerados batem com instance.json + templates/; testes do script
check-instance:
    python3 ../scripts/setup_instance.py --check
    python3 -m unittest discover -s ../scripts -p 'test_*.py'

ci: lint test check-deps check-wasm check-instance build

dev:
    npx wrangler dev

db-local:
    npx wrangler d1 migrations apply "$MAILBOX_DATABASE" --local

# Cria os recursos remotos uma vez. Depois:
# (na raiz) python3 scripts/setup_instance.py --database-id <id impresso pelo d1 create>
remote-bootstrap:
    npx wrangler r2 bucket create "$MAILBOX_BUCKET"
    npx wrangler d1 create "$MAILBOX_DATABASE"
    npx wrangler queues create "$MAILBOX_QUEUE"
    npx wrangler queues create "$MAILBOX_DLQ"

db-remote:
    npx wrangler d1 migrations apply "$MAILBOX_DATABASE" --remote

deploy: ci
    npx wrangler deploy
